+void ShaderEngine::setMediaFontPath(const QUrl &path)
+{
+    if (m_mediaFontPath == path) return;
+    if (m_mediaFontId >= 0) {
+        QFontDatabase::removeApplicationFont(m_mediaFontId);
+        m_mediaFontId = -1;
+    }
+    m_mediaFontPath = path;
+    const QString fontFile = path.isLocalFile() ? path.toLocalFile() : path.toString();
+    m_mediaFontId = QFontDatabase::addApplicationFont(fontFile);
+    const QStringList families = m_mediaFontId >= 0
+        ? QFontDatabase::applicationFontFamilies(m_mediaFontId) : QStringList();
+    m_mediaFontFamily = families.isEmpty() ? QStringLiteral("DINEngschrift") : families.first();
+    Q_EMIT mediaFontPathChanged();
+    if (!m_mediaTitle.isEmpty()) {
+        const QString currentTitle = m_mediaTitle;
+        m_mediaTitle.clear();
+        setMediaTitle(currentTitle);
+    }
+}
+
+void ShaderEngine::setMediaTitle(const QString &title)
+{
+    const QString normalized = title.simplified().toUpper();
+    if (m_mediaTitle == normalized) return;
+    m_mediaTitle = normalized;
+
+    if (m_mediaTitle.isEmpty()) {
+        m_mediaTitleImage = QImage();
+    } else {
+        QFont font(m_mediaFontFamily.isEmpty() ? QStringLiteral("DINEngschrift") : m_mediaFontFamily);
+        font.setPixelSize(200); // DIN cap height lands near the existing 148px raster glyph.
+        font.setHintingPreference(QFont::PreferNoHinting);
+        QFontMetricsF metrics(font);
+        const QString suffix = QStringLiteral("       ///       MUSIC PLAY IN PROGRESS       ///       ");
+        const QString tile = m_mediaTitle + suffix;
+        const int width = qMax(512, qCeil(metrics.horizontalAdvance(tile)) + 2);
+        m_mediaTitleImage = QImage(width, 256, QImage::Format_RGBA8888_Premultiplied);
+        m_mediaTitleImage.fill(Qt::transparent);
+        QPainter painter(&m_mediaTitleImage);
+        painter.setRenderHint(QPainter::TextAntialiasing, true);
+        painter.setFont(font);
+        painter.setPen(Qt::white);
+        const qreal baseline = (256.0 - metrics.height()) * 0.5 + metrics.ascent();
+        painter.drawText(QPointF(0.0, baseline), tile);
+    }
+    Q_EMIT mediaTitleChanged();
+    update();
+}
+
+void ShaderEngine::setMediaPlaying(bool playing)
+{
+    if (m_mediaPlaying == playing) return;
+    m_mediaPlaying = playing;
+    Q_EMIT mediaPlayingChanged();
+    update();
+}
